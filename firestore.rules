rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function mine(uid) { return request.auth != null && request.auth.uid == uid; }
    function sum3(s) { return s.w + s.d + s.l; }
    function allowedKeys() { return ['name','email','tickets','xp','level','cards','stats','lastMatch','lastPack','country','admin']; }
    function statKeys() { return ['w','d','l']; }
    // XP acumulado necessário para chegar ao nível L (igual ao jogo): 100*(L-1) + 15*(L-1)*(L-2)
    function xpAt(l) { return 100*(l-1) + 15*(l-1)*(l-2); }
    function porCards() { return ['por_bernardo_silva', 'por_bruno_fernandes', 'por_cristiano_ronaldo', 'por_diogo_costa', 'por_diogo_dalot', 'por_francisco_conceicao', 'por_goncalo_guedes', 'por_goncalo_inacio', 'por_goncalo_ramos', 'por_joao_cancelo', 'por_joao_felix', 'por_joao_neves', 'por_jose_sa', 'por_matheus_nunes', 'por_nelson_semedo', 'por_nuno_mendes', 'por_pedro_neto', 'por_rafael_leao', 'por_renato_veiga', 'por_ricardo_velho', 'por_ruben_dias', 'por_ruben_neves', 'por_rui_silva', 'por_samu_costa', 'por_tomas_araujo', 'por_trincao', 'por_vitinha']; }

    match /users/{uid} {
      allow read: if mine(uid);

      // Conta nova: tudo a zero (o jogador não se pode dar tickets, XP, cartas nem vitórias)
      allow create: if mine(uid)
        && request.resource.data.keys().hasOnly(allowedKeys())
        && !('country' in request.resource.data)
        && request.resource.data.admin == false      // ninguém se cria admin: só tu, na consola do Firebase
        && request.resource.data.name is string && request.resource.data.name.size() <= 20
        && request.resource.data.tickets == 0 && request.resource.data.xp == 0
        && request.resource.data.level == 1 && request.resource.data.cards.size() == 0
        && request.resource.data.stats.keys().hasOnly(statKeys())
        && sum3(request.resource.data.stats) == 0
        && request.resource.data.lastMatch == request.time;

      allow update: if mine(uid) && request.resource.data.keys().hasOnly(allowedKeys()) && (

        // ESCOLHER PAÍS (1 vez): só 'country' e as 27 cartas iniciais de Portugal
        ( !('country' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['country','cards'])
          && request.resource.data.country == 'PT'
          && request.resource.data.cards.diff(resource.data.cards).removedKeys().size() == 0
          && request.resource.data.cards.diff(resource.data.cards).affectedKeys().hasOnly(porCards()) )

        ||

        // GRAVAR PACKS (1 escrita por sessão de packs): gasta de 1 a 100 tickets, no máx. 1 gravação a cada 5 s.
        // O jogo abre os packs localmente e só grava quando sais do menu de packs.
        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tickets','cards','lastPack'])
          && request.resource.data.lastPack == request.time
          && request.time > resource.data.get('lastPack', timestamp.value(0)) + duration.value(5, 's')
          && resource.data.tickets - request.resource.data.tickets >= 1
          && resource.data.tickets - request.resource.data.tickets <= 100
          && request.resource.data.tickets >= 0
          && request.resource.data.cards.diff(resource.data.cards).removedKeys().size() == 0
          && request.resource.data.cards.diff(resource.data.cards).affectedKeys().size() >= 1
          && request.resource.data.cards.diff(resource.data.cards).affectedKeys().size()
             <= resource.data.tickets - request.resource.data.tickets )

        ||

        // RESULTADO DE UM JOGO (máx. 1 por 90 s): V=60 XP, E=30 XP, D=15 XP.
        // Tickets só ao subir de nível: +1 ticket por nível ganho.
        ( request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats','lastMatch','xp','level','tickets'])
          && request.resource.data.lastMatch == request.time
          && request.time > resource.data.lastMatch + duration.value(90, 's')
          && request.resource.data.stats.keys().hasOnly(statKeys())
          && (
               ( request.resource.data.xp == resource.data.xp + 60
                 && request.resource.data.stats.w == resource.data.stats.w + 1
                 && request.resource.data.stats.d == resource.data.stats.d
                 && request.resource.data.stats.l == resource.data.stats.l )
            || ( request.resource.data.xp == resource.data.xp + 30
                 && request.resource.data.stats.d == resource.data.stats.d + 1
                 && request.resource.data.stats.w == resource.data.stats.w
                 && request.resource.data.stats.l == resource.data.stats.l )
            || ( request.resource.data.xp == resource.data.xp + 15
                 && request.resource.data.stats.l == resource.data.stats.l + 1
                 && request.resource.data.stats.w == resource.data.stats.w
                 && request.resource.data.stats.d == resource.data.stats.d )
             )
          && request.resource.data.level >= resource.data.level
          && request.resource.data.level <= resource.data.level + 1
          && request.resource.data.tickets == resource.data.tickets + (request.resource.data.level - resource.data.level)
          && request.resource.data.xp >= xpAt(request.resource.data.level)
          && request.resource.data.xp < xpAt(request.resource.data.level + 1) )
      );

      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
